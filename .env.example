# Copy to .env and/or .env.local (both loaded; .env.local non-empty keys override).

# Set NODE_ENV=production on Vercel/prod. In production the server fails fast (exits when
# standalone) if required config is missing/weak — see SESSION_SECRET and the policy below.
# NODE_ENV=production

# ── Identity provider ───────────────────────────────────────────────────────────────
# AUTH_MODE selects how users sign in:
#   magic  (default) — passwordless email magic link (no corporate SSO dependency)
#   entra            — Microsoft Entra OAuth
#   both             — both enabled
AUTH_MODE=magic

# Must be at least 32 characters. Used to sign the session cookie AND magic-link tokens.
# Generate: openssl rand -base64 48
SESSION_SECRET=
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_ORIGINS=  (optional: preview web URLs, comma-separated)
# Vercel production:
# FRONTEND_ORIGIN=https://skyport-home.vercel.app

# Session lifetime for the issued JWT cookie. Stateless tokens can't be revoked,
# so keep this tight. Formats: 30m, 8h (default), 7d, or raw seconds.
# SESSION_TTL=8h

# ── Sign-in policy (applies to every provider) ──────────────────────────────────────
# Comma-separated email domains allowed to sign in (no @). For magic-link auth this is
# the gate that replaces corporate SSO. Empty in production FAILS CLOSED unless
# OAUTH_ALLOW_ANY_EMAIL=1. (AUTH_ALLOWED_EMAIL_DOMAINS is accepted as an alias.)
OAUTH_ALLOWED_MICROSOFT_EMAIL_DOMAINS=daikincomfort.com,motili.com
# OAUTH_ALLOW_ANY_EMAIL=1
# Comma-separated emails that get role=admin in the session (others get role=editor).
# OAUTH_ADMIN_EMAILS=admin@daikincomfort.com

# ── Magic-link email (AUTH_MODE=magic|both) ─────────────────────────────────────────
# How long a magic link is valid. Formats: 10m (default), 30m, raw seconds.
# MAGIC_LINK_TTL=10m
# Email delivery: with RESEND_API_KEY set, links are emailed via the Resend API (no npm
# dep). WITHOUT a provider, the link is logged to the server console (Vercel logs) so the
# flow works with zero provisioning for testing.
# RESEND_API_KEY=
# EMAIL_FROM=Skyport <login@yourverifieddomain.com>
# Override the verify-link base (defaults to FRONTEND_ORIGIN + /api/auth/verify so the
# session cookie lands first-party via the SPA /api/* rewrite).
# MAGIC_VERIFY_BASE=https://skyport-home.vercel.app/api/auth/verify

# ── Microsoft Entra (only required when AUTH_MODE includes "entra") ──────────────────
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# GUID or common only — not the full https://login.../v2.0 URL. Pin a GUID in prod.
# AUTH_MICROSOFT_ENTRA_ID_TENANT=
# OAUTH_REDIRECT_URI=http://localhost:5173/api/oauth/callback   (prod: https://skyport-core.vercel.app/oauth/callback)
# Optional: login | select_account — helps bust stuck Microsoft SSO
# OAUTH_PROMPT=login

# Optional: GET /smartsheet/sheet — server-side Smartsheet sheet JSON
# SMARTSHEET_ACCESS_TOKEN=
# SMARTSHEET_SHEET_ID=
