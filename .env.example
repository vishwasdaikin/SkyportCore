# Copy to .env and/or .env.local (both loaded; .env.local non-empty keys override).

# Set NODE_ENV=production on Vercel/prod. In production the server fails fast (exits)
# if required config is missing/weak — see SESSION_SECRET and the sign-in policy below.
# NODE_ENV=production

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# GUID or common only — not the full https://login.../v2.0 URL (causes 404 if doubled).
# Pin a tenant GUID in production; "common" lets ANY Microsoft tenant sign in.
AUTH_MICROSOFT_ENTRA_ID_TENANT=

# Local: Vite proxy — redirect URI through :5173/api
OAUTH_REDIRECT_URI=http://localhost:5173/api/oauth/callback
FRONTEND_ORIGIN=http://localhost:5173

# Vercel production (see Skyport-Web docs/VERCEL_URLS.md):
# OAUTH_REDIRECT_URI=https://skyport-core.vercel.app/oauth/callback
# FRONTEND_ORIGIN=https://skyport-home.vercel.app
# FRONTEND_ORIGINS=  (optional: preview web URLs, comma-separated)
# Preview Core: OAUTH_REDIRECT_URI must be https://<that-preview-host>/oauth/callback and listed in Azure.

# Optional: login | select_account — helps bust stuck Microsoft SSO (see Skyport-Web docs/TROUBLESHOOTING_SIGNIN.md)
# OAUTH_PROMPT=login

# Must be at least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=
PORT=3001

# Session lifetime for the issued JWT cookie. Stateless tokens can't be revoked,
# so keep this tight. Formats: 30m, 8h (default), 7d, or raw seconds. 
# SESSION_TTL=8h

# Sign-in policy (ported from the former sso-app NextAuth config)
# Comma-separated email domains allowed to sign in with Microsoft (no @).
# Empty in production FAILS CLOSED (no sign-in) unless OAUTH_ALLOW_ANY_EMAIL=1.
# OAUTH_ALLOWED_MICROSOFT_EMAIL_DOMAINS=daikincomfort.com
# Explicit opt-in to allow any email when no domain allowlist is set (use with care).
# OAUTH_ALLOW_ANY_EMAIL=1
# Comma-separated emails that get role=admin in the session (others get role=editor).
# OAUTH_ADMIN_EMAILS=admin@daikincomfort.com

# Optional: GET /smartsheet/sheet — server-side Smartsheet sheet JSON
# SMARTSHEET_ACCESS_TOKEN=
# SMARTSHEET_SHEET_ID=
